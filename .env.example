# ==============================================================================
# Environment Configuration Template for MLOps Virtual Interior Designer
#
# IMPORTANT:
# - Copy this template to `.env` for local development.
# - DO NOT commit your actual `.env` file containing real credentials to Git.
# - In production/cloud deployments, configure these values as environment variables
#   directly in your hosting dashboard (e.g., Render, Railway, AWS).
# ==============================================================================

# ------------------------------------------------------------------------------
# General Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security Keys (Replace with strong, randomly generated secrets in production)
SECRET_KEY=replace-with-a-secure-secret-key-min-32-chars
ADMIN_API_KEY=replace-with-a-secure-admin-api-key

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL (Production & Standard Development Target)
# Replace 'username', 'password', 'localhost', and 'virtual_interior_db' with your actual connection details.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/virtual_interior_db

# SQLite Fallback:
# - Set to 'true' ONLY for local development when PostgreSQL is not running.
# - CRITICAL: Production deployments must explicitly configure SQLITE_FALLBACK=false!
SQLITE_FALLBACK=true
SQLITE_DATABASE_URL=sqlite:///./virtual_interior_dev.db

# ------------------------------------------------------------------------------
# Storage & Upload Constraints
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# ML Models & MLOps Tracking
# ------------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=./ml/artifacts
ACTIVE_MODEL_VERSION=v003
MLFLOW_TRACKING_URI=./ml/experiments/mlruns

# ------------------------------------------------------------------------------
# API & Network Configuration
# ------------------------------------------------------------------------------
API_V1_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
